# Kopiera till .env.local och fyll i. Värdena delas i gruppens PRIVATA kanal —
# aldrig i GitHub (repot är publikt).

# OpenRouter (chat + embeddings) — delas av Henrik
OPENROUTER_API_KEY=

# Modeller (byt inte embedding-modellen utan gruppbeslut — kräver omindexering)
CHAT_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small

# Supabase — delas av Yasmin
SUPABASE_URL=
SUPABASE_ANON_KEY=
